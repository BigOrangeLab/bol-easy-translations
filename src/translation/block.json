{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bol/translation",
	"version": "0.1.0",
	"title": "Translation",
	"category": "text",
	"icon": "flag",
	"description": "A translation variant for a specific locale. Place inside a Localized Content block.",
	"keywords": [ "translation", "locale", "language" ],
	"parent": [ "bol/localized-content" ],
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": false
	},
	"attributes": {
		"locale": {
			"type": "string",
			"default": "en"
		},
		"label": {
			"type": "string",
			"default": "English"
		}
	},
	"textdomain": "bol-easy-translations",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
