{
	"name": "bigorangelab/bol-easy-translations",
	"description": "Localized content blocks with a language switcher",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "George Stephanis",
			"email": "George@bigorangelab.com",
			"homepage": "https://bigorangelab.com/"
		}
	],
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcsstandards/phpcsextra": "^1.0",
		"phpcsstandards/phpcsutils": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "*",
		"sirbrillig/phpcs-variable-analysis": "^2.13"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
